# Filebeat example configuration
# Replace placeholders with values for your own lab.

filebeat.inputs:
  - type: filestream
    id: system-logs
    enabled: true
    paths:
      - /var/log/*.log
      - /var/log/auth.log

output.elasticsearch:
  hosts: ["http://ELK_SERVER_IP:9200"]
  username: "YOUR_USERNAME"
  password: "YOUR_PASSWORD"

